# Names and safe placeholders ONLY. Copy to .env.local (git-ignored) and fill in your own values. Never put a real value in this file.
# The npm scripts (dev, db:*, staff:*, seed) read .env.local. Nothing reads a file called plain ".env".

# ---------------------------------------------------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------------------------------------------------
NODE_ENV=development
# Railway injects PORT itself. Leave HOST unset in production: it defaults to 0.0.0.0 there (required on Railway) and 127.0.0.1 otherwise.
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
# Largest accepted JSON request body.
BODY_LIMIT_BYTES=102400
# Seconds to let open requests finish after SIGTERM before connections are cut.
SHUTDOWN_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------------------------------------------------------------
# Database. Choose ONE. The server validates these at start-up and refuses unsafe combinations.
# ---------------------------------------------------------------------------------------------------------------------------------

# Option 1: local SQLite file (development only; refused when NODE_ENV=production).
# DB_DIALECT=sqlite
# SQLITE_PATH=./data/rio-dev.sqlite

# Option 2: the MySQL protocol.
#   production : MySQL 8 (DB_ENGINE=mysql, the default)
#   local      : the XAMPP MariaDB (DB_ENGINE=mariadb), see backend/LOCAL_DEVELOPMENT.md. No Docker.
# DB_ENGINE picks the migration folder; the tools refuse a server of the other kind.
DB_DIALECT=mysql
DB_ENGINE=mariadb
# The host in DATABASE_URL must equal DB_ALLOWED_HOST, or the app refuses to start. In production use the private host Railway gives the
# database, never a loopback address. Percent-encode special characters in the password (@ becomes %40). No query string.
DB_ALLOWED_HOST=127.0.0.1
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/rio_hospital
# DB_POOL_SIZE=10
# DB_CONNECT_TIMEOUT_SECONDS=10
# Production migrations run only with RIO_CONFIRM_MIGRATE set to the database name for that one command.
# Production staff commands (create-admin, reset-password) likewise need RIO_CONFIRM_STAFF_CLI=<database name>.

# ---------------------------------------------------------------------------------------------------------------------------------
# Browser origins (scheme and host, plus port, no path, no wildcard). Anything else is refused at start-up.
# Two separate lists, so the public site can never call a staff route and the admin site can never change a registration.
# ---------------------------------------------------------------------------------------------------------------------------------
# The ADMIN site. Only these origins may call the staff routes with the staff cookie.
ALLOWED_ORIGINS=http://localhost:3001
# The PUBLIC website. Only these origins may create, change or recover a registration. With it empty, every such change is refused.
# In production both lists must use https.
PUBLIC_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------------------------------------------------------------
# Staff authentication and public registration
# ---------------------------------------------------------------------------------------------------------------------------------
# How many reverse proxies sit in front of the API (Railway: 1). Leave 0 when nothing is in front, or a client could choose its own address.
TRUST_PROXY_HOPS=0
# A staff session ends this long after sign-in, or after this long without use, whichever comes first.
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60
# strict suits an admin site and an API on one registrable domain. none is needed only if they differ, and only in production.
SESSION_COOKIE_SAMESITE=strict
# Argon2id cost. Production refuses less than 19456 KiB and 2 passes.
ARGON2_MEMORY_KIB=65536
ARGON2_PASSES=3
# How long a registration recovery code (and its cookie) stays valid, 1 to 90 days.
REGISTRATION_TOKEN_DAYS=30

# The first administrator comes only from the command line, never over HTTP:
#   npm run staff:create-admin -- --email you@example.org --name "Your Name"

# ---------------------------------------------------------------------------------------------------------------------------------
# Object storage (Cloudflare R2). RESERVED for the upload module: the backend does not read these yet. Secrets stay server-side only.
# ---------------------------------------------------------------------------------------------------------------------------------
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET_NAME=your-private-bucket

# ---------------------------------------------------------------------------------------------------------------------------------
# Tests. Read only by the test tools, never by the server.
# ---------------------------------------------------------------------------------------------------------------------------------
# npm test                : SQLite only; it prints "MySQL/MariaDB integration tests were NOT RUN" whenever no test database is configured.
# npm run test:mariadb    : creates a random, disposable database named rio_<12 hex>_test, runs the whole suite there, drops it.
#                           It needs a DEDICATED local account (never root, never the application account) in backend/.env.test.local:
# RIO_TEST_SERVER_URL=mysql://TEST_USER:TEST_PASSWORD@127.0.0.1:3306
#                           (no database name in the URL; see backend/LOCAL_DEVELOPMENT.md for the account and its grant)
# Manual alternative for a database you created yourself (its name must end in _test, it must be local, and it is wiped by the tests):
# RIO_TEST_DATABASE_URL=mysql://TEST_USER:TEST_PASSWORD@127.0.0.1:3306/scratch_test
# RIO_TEST_DB_ENGINE=mariadb
# RIO_TEST_DB_ALLOWED_HOST=127.0.0.1
# RIO_REQUIRE_MYSQL_TESTS=yes
