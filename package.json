{
  "name": "rio-childrens-day-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "uploads:cleanup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/cleanup-uploads.ts",
    "test:pg17": "node scripts/test-pg17.mjs",
    "db:dev:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts check",
    "db:dev:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts dry-run",
    "db:dev:push": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts push",
    "test:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts check-live && node --env-file-if-exists=.env.live node_modules/vitest/vitest.mjs run --config supabase/live-tests/vitest.live.config.mts",
    "db:dev:inspect": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts inspect",
    "db:dev:advisors": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts advisors",
    "test:e2e:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts check-live && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live node_modules/@playwright/test/cli.js test --config e2e-live/playwright.live.config.ts",
    "r2:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env.live scripts/check-r2-env.ts",
    "r2:connect": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/check-r2-connection.ts",
    "test:e2e:live:upload": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts check-live && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/live-upload-run.mjs",
    "test:fixture": "playwright test --config e2e-live/playwright.fixture.config.ts",
    "test:e2e:live:journey": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/db-dev.ts check-live && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/live-journey-run.mjs",
    "staff:provision": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.live scripts/provision-staff.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "pglite-pg17": "npm:@electric-sql/pglite@^0.3.16",
    "rolldown": "1.2.16",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
